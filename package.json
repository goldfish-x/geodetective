{
  "name": "geo-detective-monorepo",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "workspaces": [
    "shared",
    "web",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "preview": "npm run preview --workspace web",
    "start:server": "npm start --workspace server",
    "test": "npm test --workspace shared && npm test --workspace server",
    "test:shared": "npm test --workspace shared",
    "test:server": "npm test --workspace server",
    "build:demo": "npm run build:demo --workspace web"
  }
}
